# Copy to .env.local for local development, and set the same keys in the
# Vercel dashboard for preview/production.

ENVIRONMENT=development
DEBUG=true

# Neon Postgres (pooled endpoint). Omitted locally -> falls back to SQLite.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/portfolio?sslmode=require

# Signs admin session cookies. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Bootstrap admin account used by `python -m app.seed`
ADMIN_EMAIL=chetansharmap7@gmail.com
ADMIN_PASSWORD=

# Mail: get an API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Inbox that receives ad board enquiries
ENQUIRY_TO=chetansharmap7@gmail.com

# Sender. onboarding@resend.dev works without a verified domain but can only
# deliver to the Resend account owner's address. Once a domain is verified in
# Resend, switch this to e.g. "Ad Board <ads@yourdomain.com>".
ENQUIRY_FROM=Portfolio Ad Board <onboarding@resend.dev>
