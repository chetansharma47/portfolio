# Copy to .env.local for `vercel dev`, and set the same keys in the Vercel dashboard.
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Inbox that receives ad board enquiries
ENQUIRY_TO=chetansharmap7@gmail.com

# Sender. onboarding@resend.dev works without a verified domain but can only
# deliver to the Resend account owner's address. Once a domain is verified in
# Resend, switch this to e.g. "Ad Board <ads@yourdomain.com>".
ENQUIRY_FROM=Portfolio Ad Board <onboarding@resend.dev>
